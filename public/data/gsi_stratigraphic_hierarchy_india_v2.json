{
  "title": "Archean Basement (Peninsular Gneissic Complex) and Precambrian-Proterozoic Supergroups of India",
  "source_note": "Compiled from GSI memoirs/state geology volumes and peer-reviewed lithostratigraphic literature. Ranks (Supergroup/Group/Subgroup) and formation names for several basins (Mahakoshal, Chhattisgarh, Bhima, Kurnool) are still debated among workers and have been revised multiple times; alternative schemes are noted where relevant. Member-level names exist only for a minority of formations. Cross-check against the latest official GSI Stratigraphic Chart of India for authoritative current usage.",
  "archean_basement": {
    "name": "Peninsular Gneissic Complex (PGC)",
    "age": "Paleoarchean to Neoarchean (c. 3400-2500 Ma)",
    "description": "Composite basement of TTG gneisses, migmatites, and granites on which the Proterozoic supergroups were unconformably deposited. Not stratified in the formal Group/Formation sense; regionally subdivided and named differently across cratons.",
    "components": [
      {"name": "Older Metamorphic Group / Sargur Group type supracrustals", "region": "Dharwar Craton, Karnataka", "note": "Oldest enclaves within PGC, includes BIF, ultramafics, pelites - see craton_sequences.dharwar for Ramakrishnan-sourced detail"},
      {"name": "Peninsular Gneiss (sensu stricto)", "region": "Dharwar Craton, Karnataka", "note": "Dominant tonalite-trondhjemite-granodiorite (TTG) gneiss, multiple phases - see craton_sequences.dharwar for Ramakrishnan-sourced detail"},
      {"name": "Closepet Granite", "region": "Dharwar Craton, Karnataka", "note": "Late Archean granite intrusion, often mapped separately from PGC gneisses"},
      {"name": "Bundelkhand Gneissic Complex (BnGC)", "region": "Bundelkhand Craton, Madhya Pradesh/Uttar Pradesh", "note": "Basement to Bijawar Group and Vindhyan Supergroup"},
      {"name": "Bastar Gneissic Complex", "region": "Bastar Craton, Chhattisgarh/Odisha", "note": "Basement to Chhattisgarh Supergroup - see craton_sequences.bastar for Ramakrishnan-sourced detail"},
      {"name": "Chhotanagpur Granite Gneissic Complex (CGGC)", "region": "Chhotanagpur Plateau, Jharkhand/Bihar/West Bengal", "note": "Basement/host to Mahakoshal-equivalent supracrustals in the east"},
      {"name": "Banded Gneissic Complex (BGC)", "region": "Aravalli-Delhi belt, Rajasthan", "note": "Basement to Aravalli and Delhi Supergroups, includes Bhilwara Supergroup gneisses"},
      {"name": "Sandur/Dharwar Gneissic Complex", "region": "Eastern Dharwar Craton, Karnataka/Andhra Pradesh", "note": "Basement to Cuddapah and Kurnool basins"}
